# PostgreSQL connection string. Set this in your local .env and Vercel environment settings.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Instagram API with Instagram Login: use the Instagram App ID/secret from Meta's Instagram setup.
META_APP_ID=""
META_APP_SECRET=""
META_REDIRECT_URI="https://insta-autopost-kappa.vercel.app/api/auth/instagram/callback"

# Generate a random 32-byte key and encode as 64 hexadecimal characters.
# Example generator: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=""

# Meta webhook verification (used when webhook routes are implemented).
META_WEBHOOK_VERIFY_TOKEN="replace-with-a-long-random-value"

# Protect scheduled endpoints. Generate a long random secret.
CRON_SECRET=""

# Optional AI provider key for later reply drafting. Never expose it in NEXT_PUBLIC_* variables.
AI_API_KEY=""
